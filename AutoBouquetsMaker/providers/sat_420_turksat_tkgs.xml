<provider>
	<name>Turksat TKGS</name>
	<streamtype>dvbs</streamtype>
	<protocol>tkgs</protocol>
	<options show_fta_options="false" />
	<!-- The TKGS table is broadcast on four beacon transponders, as in satellites.xml. The scan tunes the transponder, then the beacons in this order, until one has the table. -->
	<transponder
		orbital_position="420"
		frequency="12380000"
		symbol_rate="27500000"
		polarization="1"
		fec_inner="3"
		inversion="2"
		system="0"
		modulation="1"
		roll_off="0"
		pilot="2"
	/>
	<beacon orbital_position="420" frequency="12423000" symbol_rate="27500000" polarization="1" fec_inner="2" inversion="2" system="1" modulation="2" roll_off="0" pilot="2" />
	<beacon orbital_position="420" frequency="12423000" symbol_rate="30000000" polarization="0" fec_inner="3" inversion="2" system="0" modulation="1" roll_off="0" pilot="2" />
	<beacon orbital_position="420" frequency="12458000" symbol_rate="30000000" polarization="1" fec_inner="2" inversion="2" system="1" modulation="2" roll_off="0" pilot="2" />
	<dvbsconfigs>
		<configuration key="hd" bouquet="0x0" region="0x0" order="HD">Turksat TKGS HD</configuration>
		<configuration key="sd" bouquet="0x0" region="0x0" order="SD">Turksat TKGS SD</configuration>
	</dvbsconfigs>
	<sections>
		<section number="1">Turksat TKGS</section>
	</sections>
	<servicehacks>
<![CDATA[
# nothing to skip
]]>
	</servicehacks>
</provider>
